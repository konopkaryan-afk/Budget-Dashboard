# ── Plaid credentials ──────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com after signing up

PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# Use 'sandbox' for testing (fake data, no real bank needed)
# Use 'production' once approved for real Chase / Wells Fargo / Schwab
PLAID_ENV=sandbox

# ── Dashboard password ─────────────────────────────────────────────────
# Anyone visiting the URL must enter this password to access the dashboard
DASHBOARD_PASSWORD=your_password_here

# Secret used to sign the login cookie — make this long and random
COOKIE_SECRET=some-long-random-string-change-this

# Port for the local server
PORT=3000
